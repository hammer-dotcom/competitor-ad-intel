{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": {
    "startCommand": "python -m src.mcp_server --http --port $PORT",
    "healthcheckPath": "/mcp",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
