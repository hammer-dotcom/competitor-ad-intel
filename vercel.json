{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pip install -r requirements.txt && python -m src.demo",
  "outputDirectory": "site",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/issues/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
